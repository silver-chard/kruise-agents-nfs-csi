# Existing production NFS wrapper image supplies /nfsplugin and its runtime.
# Build dist/linux-amd64 binaries first with Go 1.26.3 or newer.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY dist/linux-amd64/kruise-nfs-wrapper /usr/local/bin/kruise-nfs-wrapper
COPY dist/linux-amd64/kruise-nfs-mounter /usr/local/bin/kruise-nfs-mounter
COPY build/wrapper/entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh /usr/local/bin/kruise-nfs-wrapper /usr/local/bin/kruise-nfs-mounter \
    && test -x /nfsplugin
ENTRYPOINT ["/entrypoint.sh"]
CMD []
